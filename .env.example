# Soil & Crop Health Analyzer — Environment Configuration

# Backend Settings
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# ML Configuration
MODEL_PATH=ml/models/plant_disease_mobilenetv2.h5
CONFIDENCE_THRESHOLD=0.60
USE_DEMO_FALLBACK=true

# Supabase (PostgreSQL & Auth)
# Leave empty to use local zero-config SQLite development mode
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# AI Assistant Settings (Optional External LLM or built-in agronomy knowledge base)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
