{
  "name": "soil-crop-health-analyzer",
  "version": "1.0.0",
  "private": true,
  "description": "AI-Powered Soil & Crop Health Analyzer",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "python -m uvicorn backend.app.main:app --host 127.0.0.1 --port 8000 --reload",
    "build": "npm --prefix frontend run build",
    "test:backend": "python -m pytest backend/tests/ -v",
    "test:e2e": "python backend/tests/test_e2e_flow.py",
    "test": "npm run test:backend && npm run test:e2e"
  }
}
